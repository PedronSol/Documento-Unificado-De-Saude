# Imagem de produção do Railway. O contexto de build é a raiz do repositório.
FROM node:20-slim

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV NEXT_TELEMETRY_DISABLED=1

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ .

# Variáveis NEXT_PUBLIC_* e o alvo do proxy /api (spec 041) são resolvidos
# durante o build.
ARG NEXT_PUBLIC_API_URL
ARG API_PROXY_TARGET
ARG NEXT_PUBLIC_GOOGLE_CLIENT_ID
RUN npm run build

ENV NODE_ENV=production
CMD ["sh", "-c", "npm run start -- -p ${PORT:-3000}"]
